(form
  :type-tag      "Form/v1"
  :name          "treapbranch_proj_cap_entry"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      2
  :code (
    STORE   0
