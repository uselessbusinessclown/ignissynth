; Treap schema sub-helpers — byte-layout level for TreapEmpty/v1
; and TreapBranch/v1 substances.
;
; These Forms implement the field projections, type-tag checks,
; constructors, and branch operations that treap.form's four public
; operations delegate to. Each one reads a sealed substance, verifies
; the type tag, and returns the field at the known offset documented
; in kernel/types/Treap.md.
;
; Synthesis chain:
;   provocation:  STUBS.md catalogues 15 Treap schema sub-helpers as
;                 pending. The treap operations in treap.form delegate
;                 to them at every inner CALL; until they are encoded,
;                 those operations have pending leaves.
;   grounding:    A1.1 (substance is named by hash), A1.2 (type is
;                 intrinsic), A1.3 (sealing is permanent), A2.3
;                 (revocation cascades — generation is stored per node)
;   composes_with:
;                 - kernel/types/Treap.md (the layout spec)
;                 - schema-helpers.form (Schema/verify_type_tag,
;                   Schema/bytes_in_range, Schema/nat_at, Schema/mul)
;                 - treap.form (the public treap operations)
;                 - primitives.form (Vec/append, Vec/len, Vec/index)
;
; Each helper has the same shape:
;   :declared-caps (S-03/ROOT_RO)        ; only READ (constructors
;                                        ; also need S-03/SEAL_RW)
;   :declared-traps (ETYPE)              ; trap on tag mismatch
;   body: verify type tag → read/construct field → RET
;
; Helper exemption: every Form below is under ~30 instructions of IL
; and is therefore exempt from its own .proof artifact per
; synthesis/PROTOCOL.md § Helper exemption.
;
; Layout reference (kernel/types/Treap.md):
;
;   TreapEmpty/v1:
;     offset 0  type_tag  Bytes(13)  "TreapEmpty/v1"
;
;   TreapBranch/v1:
;     offset 0    type_tag   Bytes(14)  "TreapBranch/v1"
;     offset 14   cap_id     Hash(32)   the BST key
;     offset 46   priority   Nat(8)     derived from cap_id
;     offset 54   cap_entry  Hash(32)   hash of CapEntry/v1 substance
;     offset 86   left       Hash(32)   left subtree root
;     offset 118  right      Hash(32)   right subtree root
;     total: 150 bytes

; ============================================================
; Treap/type_tag_is_empty — (Bytes) → Bool
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_type_tag_is_empty"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      1
  :code (
    STORE   0
    LOAD    0
    PUSH    "TreapEmpty/v1"
    PUSH    "Schema/verify_type_tag"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/type_tag_is_branch — (Bytes) → Bool
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_type_tag_is_branch"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      1
  :code (
    STORE   0
    LOAD    0
    PUSH    "TreapBranch/v1"
    PUSH    "Schema/verify_type_tag"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; TreapBranch/proj/cap_id — (Bytes) → Hash
;
; Returns the 32-byte cap_id at offset 14.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treapbranch_proj_cap_id"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      2
  :code (
    STORE   0
    LOAD    0
    PUSH    "TreapBranch/v1"
    PUSH    "Schema/verify_type_tag"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    POP
    LOAD    0
    PUSH    14                        ; offset
    PUSH    32                        ; length
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

