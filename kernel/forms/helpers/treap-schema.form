; ============================================================
; Treap/key_lt — (CapId, CapId) → Bool
;
; Lexicographic comparison on 32-byte hash values. Returns true
; iff the first CapId is strictly less than the second.
;
; The IL compares Values by structural equality (EQ) but has no
; direct lexicographic bytes comparison. We delegate to a
; sub-helper Treap/bytes_lt that implements lexicographic
; comparison via byte-at-a-time recursion.
;
; For the scaffold, this is a pending leaf — the CALL will trap
; EUNBOUND until Treap/bytes_lt is encoded in a future batch.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_key_lt"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         2
  :locals-n      2
  :code (
    STORE   0                            ; locals[0] := a (CapId Hash)
    STORE   1                            ; locals[1] := b (CapId Hash)
    LOAD    0
    LOAD    1
    PUSH    "Treap/bytes_lt"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2                      ; → Bool
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/derive_priority — (CapId) → Nat
;
; Computes priority = first 8 bytes of BLAKE3(CapId ‖ "treap-priority")
; interpreted as Nat(8).
;
; This requires:
;   1. Concatenating CapId (32 bytes) with "treap-priority" (15 bytes)
;   2. Hashing the 47-byte result with BLAKE3
;   3. Taking the first 8 bytes as a big-endian Nat
;
; The IL has SEAL (which hashes) but no raw BLAKE3 opcode. We
; approximate by sealing the concatenation under a tag and reading
; the hash, then extracting the first 8 bytes. However, SEAL's hash
; includes the type tag in the canonical bytes, so the result is
; NOT the same as BLAKE3(CapId ‖ "treap-priority").
;
; For the scaffold, we delegate to a sub-helper Treap/blake3_prefix
; that will be encoded when the IL has a raw-hash opcode or when
; the canonicaliser is available. This is a pending leaf.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_derive_priority"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      2
  :code (
    STORE   0                            ; locals[0] := cap_id (Hash)

    ;; Seal the cap_id under "TreapPriority/v1" to get a deterministic
    ;; hash, then extract the first 8 bytes as the priority.
    ;; NOTE: this is an approximation. The real priority is
    ;; BLAKE3(cap_id ‖ "treap-priority"), not BLAKE3("TreapPriority/v1" ‖ cap_id).
    ;; The exact derivation will be corrected when the canonicaliser
    ;; helper is available. For now, the priority is deterministic
    ;; and key-dependent, which is sufficient for the treap's shape
    ;; canonicity property.
    LOAD    0
    PUSH    "TreapPriority/v1"
    SEAL    Hash                          ; → deterministic hash of cap_id
    STORE   1

    ;; Extract the first 8 bytes as a Nat.
    ;; We delegate to Schema/nat_at on the hash bytes.
    ;; However, the hash is a Hash value, not Bytes. We need to
    ;; read it as a value and extract bytes. The IL's Hash is
    ;; opaque — we can compare hashes but not read individual bytes.
    ;;
    ;; For the scaffold, we return the hash itself as a Nat.
    ;; This is wrong for production but sufficient for the scaffold's
    ;; structural testing. The real implementation needs a raw-bytes
    ;; accessor opcode or the canonicaliser.
    ;;
    ;; Delegating to Treap/hash_to_priority sub-helper (pending).
    LOAD    1
    PUSH    "Treap/hash_to_priority"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1                      ; → Nat (priority)
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/seal_leaf_branch — (CapId, Nat, Hash) → TreapRoot
;
; Constructs and seals a TreapBranch/v1 node from (cap_id, priority,
; cap_entry_hash). The left and right children default to
; BOTTOM_HASH (empty treap).
;
; Returns the sealed branch hash.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_seal_leaf_branch"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         3
  :locals-n      4
  :code (
    STORE   0                            ; locals[0] := cap_id
    STORE   1                            ; locals[1] := priority
    STORE   2                            ; locals[2] := cap_entry hash

    ;; Build the branch as a tagged value.
    ;; Vec{cap_id, priority, cap_entry, left=BOTTOM, right=BOTTOM}
    LOAD    0
    LOAD    1
    LOAD    2
    PUSH    BOTTOM_HASH                  ; left = empty
    PUSH    BOTTOM_HASH                  ; right = empty
    MAKEVEC   5
    STORE   3
    LOAD    3
    PUSH    "TreapBranch/v1"
    SEAL    Hash                          ; → sealed branch hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/branch_insert — (Bytes, Hash) → TreapRoot
;
; Given a branch's bytes and a new cap_entry hash, inserts the
; entry into the subtree rooted at this branch. BST-inserts by
; cap_id, then rotates up to maintain the heap property.
;
; Delegates to S-02/treap/insert for the recursion.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_branch_insert"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE EBADLOCAL)
  :arity         2
  :locals-n      5
  :code (
    STORE   0                            ; locals[0] := branch bytes
    STORE   1                            ; locals[1] := new cap_entry hash

    ;; Extract this branch's cap_id.
    LOAD    0
    PUSH    "TreapBranch/proj/cap_id"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   2                            ; locals[2] := branch cap_id

    ;; Compare: new_cap_id < branch_cap_id?
    ;; We need the new cap_id from the cap_entry. The caller passes
    ;; the cap_entry hash; we need to read it and extract cap_id.
    ;; However, the cap_id is the BST key, which the caller derived.
    ;; For the scaffold, we delegate to Treap/branch_insert_dispatch
    ;; which handles the comparison and recursion.
    LOAD    0
    LOAD    1
    PUSH    "Treap/branch_insert_dispatch"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2                      ; → new subtree hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/branch_bump_generation — (Bytes, CapId) → TreapRoot
;
; Locates the entry for cap_id in the subtree, bumps its generation,
; and returns the new subtree root.
;
; Delegates to S-02/treap/bump_generation for the recursion.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_branch_bump_generation"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE EBADLOCAL)
  :arity         2
  :locals-n      4
  :code (
    STORE   0                            ; locals[0] := branch bytes
    STORE   1                            ; locals[1] := cap_id

    ;; Extract this branch's cap_id.
    LOAD    0
    PUSH    "TreapBranch/proj/cap_id"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   2

    ;; Compare cap_ids to decide direction.
    LOAD    2
    LOAD    1
    EQ
    JMPZ    +bump_not_match

    ;; Match — bump this node's generation.
    ;; Delegate to CapEntry/with_generation_inc.
    LOAD    0
    PUSH    "TreapBranch/proj/cap_entry"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    PUSH    "CapEntry/with_generation_inc"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1                      ; → new cap_entry hash
    STORE   3

    ;; Rebuild branch with new cap_entry.
    LOAD    0
    LOAD    3
    PUSH    "Treap/branch_replace_entry"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2                      ; → new branch hash
    RET

    :bump_not_match
    ;; Not at this node — delegate to Treap/branch_bump_dispatch
    ;; which compares keys and recurses into left or right.
    LOAD    0
    LOAD    1
    PUSH    "Treap/branch_bump_dispatch"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2                      ; → new subtree hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/branch_replace_entry — (Bytes, Hash) → Hash
;
; Replaces the cap_entry in a branch, keeping everything else
; (cap_id, priority, left, right) unchanged. Returns the new
; sealed branch hash.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_branch_replace_entry"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         2
  :locals-n      6
  :code (
    STORE   0                            ; locals[0] := branch bytes
    STORE   1                            ; locals[1] := new cap_entry hash

    ;; Extract all fields.
    LOAD    0
    PUSH    "TreapBranch/proj/cap_id"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   2                            ; cap_id

    LOAD    0
    PUSH    "TreapBranch/proj/left"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   3                            ; left

    LOAD    0
    PUSH    "TreapBranch/proj/right"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   4                            ; right

    ;; Derive priority (deterministic from cap_id).
    LOAD    2
    PUSH    "Treap/derive_priority"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   5                            ; priority

    ;; Reconstruct and seal.
    LOAD    2
    LOAD    5
    LOAD    1
    LOAD    3
    LOAD    4
    MAKEVEC   5
    PUSH    "TreapBranch/v1"
    SEAL    Hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/check_revocation_chain — (TreapRoot, CapId, Hash) → Hash
;
; Walks the cap derivation chain (via CapEntry.parent) from the
; matched node, re-doing a lookup on each parent and comparing
; the stored generation against the recorded one. Returns
; BOTTOM_HASH if any ancestor's generation is higher, otherwise
; returns the matched cap_entry hash.
;
; This is the core of lookup_with_revocation. It delegates to
; S-02/treap/lookup for each ancestor lookup.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_check_revocation_chain"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         3
  :locals-n      5
  :code (
    STORE   0                            ; locals[0] := treap root
    STORE   1                            ; locals[1] := cap_id
    STORE   2                            ; locals[2] := recorded generation

    ;; Look up the entry for cap_id.
    LOAD    0
    LOAD    1
    PUSH    "S-02/treap/lookup"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    STORE   3                            ; locals[3] := cap_entry or BOTTOM

    ;; If not found, return BOTTOM.
    LOAD    3
    PUSH    BOTTOM_HASH
    EQ
    JMPZ    +rvc_found
    PUSH    BOTTOM_HASH
    RET

    :rvc_found
    ;; Delegate the chain walk to Treap/revocation_walk which
    ;; recurses through CapEntry.parent lookups. This is a pending
    ;; leaf — the sub-helper needs CapEntry/proj/parent and
    ;; CapEntry/proj/generation which are not yet encoded.
    LOAD    0
    LOAD    3
    LOAD    2
    PUSH    "Treap/revocation_walk"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3                      ; → cap_entry or BOTTOM
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; CapEntry/with_generation_inc — (CapEntry) → CapEntry
;
; Returns a new CapEntry with generation + 1. Reads the existing
; entry, extracts all fields, re-constructs with generation + 1.
;
; CapEntry/v1 layout (from SCHEMA.md):
;   offset 0   type_tag   Bytes(11)  "CapEntry/v1"
;   offset 11  holder     Hash(32)   MindId
;   offset 43  generation Nat(8)     generation counter
; Total: 51 bytes
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "capentry_with_generation_inc"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      3
  :code (
    STORE   0                            ; locals[0] := cap_entry hash

    ;; Read the cap_entry substance.
    LOAD    0
    READ
    STORE   1                            ; locals[1] := entry bytes

    ;; Read generation (offset 43, 8 bytes).
    LOAD    1
    PUSH    43
    PUSH    "Schema/nat_at"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    STORE   2                            ; locals[2] := generation

    ;; Increment generation.
    LOAD    2
    PUSH    1
    ADD
    STORE   2

    ;; Reconstruct: we need holder (offset 11, 32 bytes) + new generation.
    ;; Delegate to CapEntry/construct (pending sub-helper) or
    ;; seal directly. For the scaffold, we seal the pair
    ;; (holder, new_generation) under "CapEntry/v1".
    LOAD    1
    PUSH    11
    PUSH    32
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3                      ; → holder Hash
    LOAD    2                            ; new generation
    MAKEPAIR                              ; Pair{holder, generation}
    PUSH    "CapEntry/v1"
    SEAL    Hash                          ; → new cap_entry hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

; ============================================================
; Treap/seal_entry — (CapEntry) → Hash
;
; Seals a CapEntry/v1 substance and returns its hash.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "treap_seal_entry"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         1
  :locals-n      1
  :code (
    STORE   0
    LOAD    0
    PUSH    "CapEntry/v1"
    SEAL    Hash
    RET
  )
  :rationale-hash $$BLAKE3$$/treap-schema-rationale
)

(exports
  (treap_type_tag_is_empty         (Bytes) → Bool)
  (treap_type_tag_is_branch        (Bytes) → Bool)
  (treapbranch_proj_cap_id         (Bytes) → Hash)
  (treapbranch_proj_cap_entry      (Bytes) → Hash)
  (treapbranch_proj_left           (Bytes) → Hash)
  (treapbranch_proj_right          (Bytes) → Hash)
  (treap_key_lt                    (Hash, Hash) → Bool)
  (treap_derive_priority           (Hash) → Nat)
  (treap_seal_leaf_branch          (Hash, Nat, Hash) → Hash)
  (treap_branch_insert             (Bytes, Hash) → Hash)
  (treap_branch_bump_generation    (Bytes, Hash) → Hash)
  (treap_branch_replace_entry      (Bytes, Hash) → Hash)
  (treap_check_revocation_chain    (Hash, Hash, Hash) → Hash)
  (capentry_with_generation_inc    (Hash) → Hash)
  (treap_seal_entry                (Hash) → Hash))

; ============================================================
; Notes on pending sub-helper leaves
;
; The helpers above delegate to the following sub-helpers that
; are NOT yet encoded. They are catalogued here for the next batch:
;
;   Treap/bytes_lt (Hash, Hash) → Bool
;     Lexicographic comparison of two 32-byte hashes. Requires
;     byte-at-a-time recursion over hash bytes.
;
;   Treap/hash_to_priority (Hash) → Nat
;     Extracts the first 8 bytes of a hash as a big-endian Nat.
;     Requires a raw-bytes accessor for Hash values.
;
;   Treap/branch_insert_dispatch (Bytes, Hash) → Hash
;     BST comparison + recursion dispatch for insert.
;
;   Treap/branch_bump_dispatch (Bytes, Hash) → Hash
;     BST comparison + recursion dispatch for bump_generation.
;
;   Treap/revocation_walk (Hash, Hash, Hash) → Hash
;     Recursive walk through CapEntry.parent chain.
;
; These five sub-helpers depend on primitives not yet in the IL
; (lexicographic bytes comparison, raw hash byte extraction).
; They will be encoded when the IL gains those primitives or
; when the canonicaliser helper provides them.
;
; The helpers encoded above close 15 of the 20 total pending
; treap-schema slots. The remaining 5 are deeper primitives.
; ============================================================
