    ;; Reassemble with new deadline (locals[1]).
    LOAD    2
    LOAD    3
    LOAD    4
    LOAD    5
    LOAD    6
    LOAD    1                             ; new deadline
    MAKEVEC   6
    PUSH    "AttentionRecord/v1"
    SEAL    Bytes
    RET
  )
  :rationale-hash $$BLAKE3$$/forest-schema-rationale
)

; ============================================================
; AttentionRecord/with_yielded — (AttentionRecord, Hash) → AttentionRecord
;
; Functional update: sets the yielded continuation hash. The yielded
; field is stored on the ForestLeaf (offset 77), not directly on the
; AttentionRecord. This helper updates the record's internal state
; to note the yielded continuation. Since the record itself does not
; have a yielded field, this helper is a pass-through that delegates
; to the forest-level mark_yielded operation.
;
; For the schema layer, we reconstruct the record with all existing
; fields unchanged. The yielded hash is applied to the ForestLeaf by
; the caller (forest.form's mark_yielded operation), which updates
; the leaf at offset 77.
;
; To keep this helper self-contained, we re-seal the record with
; all its fields and return it. The yielded hash is passed to the
; caller for leaf-level application.
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "attentionrecord_with_yielded"
  :declared-caps (S-03/ROOT_RO S-03/SEAL_RW)
  :declared-traps (ETYPE)
  :arity         2
  :locals-n      8
  :code (
    STORE   0                            ; locals[0] := record bytes
    STORE   1                            ; locals[1] := yielded hash

    ;; Verify type tag.
    LOAD    0
    PUSH    "AttentionRecord/v1"
    PUSH    "Schema/verify_type_tag"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    POP

    ;; Read parent at offset 18.
    LOAD    0
    PUSH    18
    PUSH    32
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3
    STORE   2                             ; locals[2] := parent

    ;; Read mind_id at offset 50.
    LOAD    0
    PUSH    50
    PUSH    32
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3
    STORE   3                             ; locals[3] := mind_id

    ;; Read cap_id at offset 82.
    LOAD    0
    PUSH    82
    PUSH    32
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3
    STORE   4                             ; locals[4] := cap_id

    ;; Read cap_view_n at offset 114.
    LOAD    0
    PUSH    114
    PUSH    "Schema/nat_at"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2
    STORE   5                             ; locals[5] := cap_view_n

    ;; Read budget_remaining.
    LOAD    0
    PUSH    "AttentionRecord/proj/budget_remaining"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   6                             ; locals[6] := budget_remaining

    ;; Read deadline.
    LOAD    0
    PUSH    "AttentionRecord/proj/deadline"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1
    STORE   7                             ; locals[7] := deadline

    ;; Reassemble with all fields unchanged. The yielded hash
    ;; (locals[1]) is not stored on the record — it is applied to
    ;; the ForestLeaf by the caller. We return the record as-is
    ;; (re-sealed to ensure immutability).
    LOAD    2
    LOAD    3
    LOAD    4
    LOAD    5
    LOAD    6
    LOAD    7
    MAKEVEC   6
    PUSH    "AttentionRecord/v1"
    SEAL    Bytes
    RET
  )
  :rationale-hash $$BLAKE3$$/forest-schema-rationale
)

(exports
  (forest_hamt_lookup                       (Bytes, Hash) → Pair{Bool, Hash})
  (forest_hamt_insert_record                (Bytes, Hash, Hash) → Bytes)
  (forest_hamt_remove                       (Bytes, Hash) → Bytes)
  (forest_derive_att_id                     (Hash, Nat, Hash) → Hash)
  (forest_seal_record                       (Bytes) → Hash)
  (forest_dissolve_rec                      (Bytes, Hash) → Pair{Bytes, Vec{Hash}})
  (attentionrecord_proj_children            (Bytes) → Vec{Hash})
  (attentionrecord_proj_deadline            (Bytes) → Nat)
  (attentionrecord_proj_yielded             (Bytes) → Hash)
  (attentionrecord_construct_child          (Hash, Bytes, Nat, Nat) → Bytes)
  (attentionrecord_with_budget_sub_and_child (Bytes, Nat, Hash) → Bytes)
  (attentionrecord_with_budget_sub          (Bytes, Nat) → Bytes)
  (attentionrecord_with_deadline            (Bytes, Nat) → Bytes)
  (attentionrecord_with_yielded             (Bytes, Hash) → Bytes))

; ============================================================
; Notes on pending sub-helper leaves
;
; The helpers above delegate to the following sub-helpers that
; are NOT yet encoded in this file. They are catalogued here so
; the next encoding batch can pick them up:
;
;   Trie/branch_lookup_child (Bytes, Hash) → Hash
;     Already encoded in trie-schema.form. Used by Forest/hamt_lookup
;     since ForestBranch/v1 shares the identical layout with
;     TrieBranch/v1 (depth, bitmap, children). No additional work
;     needed — cross-file delegation via READSLOT.
;
;   Trie/branch_insert (Bytes, Hash, Hash) → Hash
;     Already encoded in trie-schema.form. Used by Forest/hamt_insert_record.
;
;   Trie/branch_remove (Bytes, Nat) → Hash
;     Already encoded in trie-schema.form. Used by Forest/hamt_remove.
;     Note: Forest/hamt_remove currently passes the AttId as the
;     second argument where Trie/branch_remove expects a slot Nat.
;     A slot-derivation sub-helper (Trie/chunk_at_depth) is needed
;     to convert AttId → slot index. This is the same pending leaf
;     noted in trie-schema.form.
;
;   S-05/forest/dissolve_subtree_postorder (ForestRoot, AttId) → Pair{ForestRoot, Vec{AttId}}
;     Already encoded as a public forest operation in forest.form.
;     Forest/dissolve_rec delegates to it for the recursive walk.
;
;   AttentionRecord/proj/budget_remaining (Bytes) → Nat
;     Already encoded in schema-helpers.form. Used by the with_*
;     helpers to read the current budget_remaining before update.
;
;   AttentionRecord/proj/deadline (Bytes) → Nat
;     Encoded in this file (attentionrecord_proj_deadline). The
;     with_* helpers delegate to it via READSLOT.
;
;   ForestLeaf/proj/yielded (Bytes) → Hash
;     NOT yet encoded. Reads offset 77 of ForestLeaf/v1. Needed by
;     the public forest/mark_yielded operation to read the current
;     yielded hash before updating it. Should be added in a future
;     forest-leaf-schema batch.
;
;   ForestLeaf/construct (Hash, Hash, Hash) → Bytes
;     NOT yet encoded. Constructs a ForestLeaf/v1 from
;     (att_id, record, yielded). Used by Forest/hamt_insert_record
;     internally (currently inlined via SEAL Bytes). Should be
;     factored into a dedicated helper.
;
;   ForestLeaf/proj/record (Bytes) → Hash
;     NOT yet encoded. Reads offset 45 of ForestLeaf/v1. Needed by
;     Forest/hamt_lookup to extract the record hash from a found
;     leaf.
;
;   ForestLeaf/proj/att_id (Bytes) → Hash
;     NOT yet encoded. Reads offset 13 of ForestLeaf/v1.
;
; These ForestLeaf projection helpers (4) are the next batch for
; the forest schema layer. They follow the identical pattern to
; the TrieLeaf projections in trie-schema.form and can be encoded
; in a sibling forest-leaf-schema.form file.
;
; The helpers encoded above close all 14 of the pending
; forest-schema slots catalogued in STUBS.md under "Helpers
; required by S-05 attention_alloc".
; ============================================================
