    ;; Slice 4 bytes at offset.
    LOAD    0
    LOAD    1
    PUSH    4                            ; nat4 length
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3                     ; → Bytes (4-byte slice)
    STORE   2                            ; locals[2] := slice

    ;; Decode big-endian nat.
    LOAD    2
    PUSH    "Bytes/to_nat_be"
    SEAL    Hash
    READSLOT
