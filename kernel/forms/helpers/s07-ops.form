; S-07 form_runtime operational helpers and Parser binary-field
; leaves.
;
; This file encodes 15 helpers in two groups:
;
;   Group 1 — Parser binary-field leaves (4 Forms):
;     Parser/check_record_header, Parser/read_hash_at,
;     Parser/read_nat4_at, Parser/read_nat8_at.
;     These are the fixed-offset readers the binary record
;     parsers delegate to. Each validates or slices a
;     fixed-width field from a sealed Bytes substance.
;
;   Group 2 — S-07 form_runtime helpers (11 Forms):
;     S-07/interp/run (the 35-opcode dispatch table — the
;     load-bearing helper), S-07/finalise_invocation, the
;     three canon/* helpers, S-07/zeros, S-07/reverse,
;     S-07/spent, S-07/check/cap_view_contains, S-07/vec/len,
;     S-07/vec/index.
;
; Synthesis chain:
;   provocation:  STUBS.md items "Parser/* binary-field leaves"
;                 and "Helpers required by S-07 form_runtime"
;                 list these 15 helpers as pending. The primary
;                 S-07-form-runtime.form and the record parsers
;                 reference them at inner CALLs; until encoded,
;                 those operations have pending leaves.
;   grounding:    A1.2 (type is intrinsic — dispatch by
;                 type-tag), A1.3 (sealing is permanent — bytes
;                 don't move), A6.1 (a unit of code is a
;                 substance), A0.6 (code is thought, not artifact)
;   composes_with:
;                 - schema-helpers.form (Schema/verify_type_tag,
;                   Schema/bytes_in_range, Schema/nat_at)
;                 - primitives.form (Vec/len, Vec/index,
;                   Vec/append, Bytes/len, Bytes/slice,
;                   Bytes/to_nat_be)
;                 - intrinsics.form (Vec/len, Vec/index)
;                 - S-07-form-runtime.form (the primary operation)
;
; Helper exemption: every Form below is under ~30 instructions
; of IL and is therefore exempt from its own .proof artifact
; per synthesis/PROTOCOL.md § Helper exemption, with the single
; exception of S-07/interp/run, which is the 35-opcode dispatch
; table and carries its own proof obligation documented in
; STUBS.md under "Non-exempt helpers requiring proof artifacts."
; A kernel-author identity verifies each body by structural
; reading in the S-08 inspection record.
;
; ============================================================
; Parser/check_record_header — (Bytes, Bytes, Nat) → Bool
;
; Checks whether `bytes` starts with the given type tag and has
; at least `min_len` bytes. Returns true iff both conditions
; hold. Delegates to Parser/bytes_starts_with for the prefix
; check and Bytes/len for the length check.
;
; Declared-caps: (S-03/ROOT_RO)
; Declared-traps: (ETYPE)
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "parser_check_record_header"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         3
  :locals-n      4
  :code (
    STORE   0                            ; locals[0] := bytes (Bytes)
    STORE   1                            ; locals[1] := type_tag (Bytes)
    STORE   2                            ; locals[2] := min_len (Nat)

    ;; Check prefix: bytes_starts_with(bytes, type_tag).
    LOAD    0
    LOAD    1
    PUSH    "Parser/bytes_starts_with"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=2                     ; → Bool
    STORE   3                            ; locals[3] := tag_ok

    ;; If tag mismatch, return false immediately.
    LOAD    3
    JMPZ   +header_fail

    ;; Check length: Bytes/len(bytes) >= min_len.
    LOAD    0
    PUSH    "Bytes/len"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1                     ; → Nat
    LOAD    2
    LT                                     ; min_len < len  → true means ok
    JMPZ   +header_fail                   ; min_len >= len means fail
    PUSH    true
    RET

    :header_fail
    PUSH    false
    RET
  )
  :rationale-hash $$BLAKE3$$/s07-ops-rationale
)

; ============================================================
; Parser/read_hash_at — (Bytes, Nat) → Hash
;
; Reads a 32-byte Hash at the given byte offset in `bytes`.
; Delegates to Schema/bytes_in_range to slice and to
; Schema/tail_hash to cast the 32-byte slice to a Hash.
;
; Declared-caps: (S-03/ROOT_RO)
; Declared-traps: (ETYPE)
; ============================================================

(form
  :type-tag      "Form/v1"
  :name          "parser_read_hash_at"
  :declared-caps (S-03/ROOT_RO)
  :declared-traps (ETYPE)
  :arity         2
  :locals-n      3
  :code (
    STORE   0                            ; locals[0] := bytes (Bytes)
    STORE   1                            ; locals[1] := offset (Nat)

    ;; Slice 32 bytes at offset: bytes_in_range(bytes, offset, 32).
    LOAD    0
    LOAD    1
    PUSH    32                           ; hash length
    PUSH    "Schema/bytes_in_range"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=3                     ; → Bytes (32-byte slice)
    STORE   2                            ; locals[2] := slice

    ;; Cast 32-byte slice to Hash.
    LOAD    2
    PUSH    "Schema/tail_hash"
    SEAL    Hash
    READSLOT
    CALL    h=$ /n=1                     ; → Hash
    RET
  )
  :rationale-hash $$BLAKE3$$/s07-ops-rationale
)

