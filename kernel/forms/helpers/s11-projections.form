(exports
  (S11_proj_acceptance_form    (Hash) → Hash)
  (S11_proj_match_kind         (Hash) → MatchKind)
  (S11_proj_fulfiller_hash     (Hash) → Hash)
  (S11_proj_sub_attention_id   (Hash) → AttId)
  (S11_proj_none_reason        (Hash) → Reason))
